#!/usr/bin/env julia
using DavydovFoldon

function usage(io::IO=stdout)
    println(io, "usage: davydovfoldon predict SEQUENCE [output.h5] [--tmax SECONDS] [--dt SECONDS] [--temperature K] [--seed N]")
end

function main(args::Vector{String})::Int
    if isempty(args) || args[1] in ("-h", "--help")
        usage()
        return isempty(args) ? 2 : 0
    end
    length(args) >= 2 && args[1] == "predict" || (usage(stderr); return 2)
    sequence = args[2]
    has_output = length(args) >= 3 && !startswith(args[3], "--")
    output = has_output ? args[3] : "results.h5"
    option_start = has_output ? 4 : 3
    options = Dict("--tmax" => "20.0", "--dt" => "0.01",
                   "--temperature" => "310.0", "--seed" => "42")
    i = option_start
    while i <= length(args)
        haskey(options, args[i]) || (println(stderr, "unknown option: ", args[i]); return 2)
        i < length(args) || (println(stderr, "missing value for ", args[i]); return 2)
        options[args[i]] = args[i + 1]
        i += 2
    end
    params = DavydovParams(seed=parse(Int, options["--seed"]))
    trajectory, _, _ = run_soliton(sequence, params;
        tmax=parse(Float64, options["--tmax"]), dt=parse(Float64, options["--dt"]),
        T=parse(Float64, options["--temperature"]))
    save_trajectory(output, trajectory)
    println(output)
    return 0
end

exit(main(ARGS))
